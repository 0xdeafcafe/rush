; rush's tests run under this: they may do anything except touch the user's
; real rush, agents and sessions. Run through rust/tools/sbtest.sh, which
; passes HOME. Any denial shows in: log show --predicate 'sender == "Sandbox"'
(version 1)
(allow default)

; No writes to the real homes of rush and the agents it runs...
(deny file-write*
  (subpath (string-append (param "HOME") "/.config"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.codex"))
  (subpath (string-append (param "HOME") "/Library/Caches/agtop"))
  (subpath (string-append (param "HOME") "/Library/Caches/rush")))
; ...except the scratch folder builds and test homes may live in.
(allow file-write* (subpath (param "SCRATCH")))

; No talking to a live host, plugin broker or menu bar.
(deny network-outbound
  (remote unix-socket (subpath (string-append (param "HOME") "/.config")))
  (remote unix-socket (subpath (string-append (param "HOME") "/.claude"))))

; No running the user's own rush or agents.
(deny process-exec
  (literal (string-append (param "HOME") "/go/bin/rush"))
  (literal (string-append (param "HOME") "/.local/share/rush-rs/rush"))
  (literal "/opt/homebrew/bin/claude")
  (literal "/opt/homebrew/bin/codex")
  (subpath "/opt/homebrew/Caskroom/claude-code")
  (subpath "/opt/homebrew/Caskroom/claude-code@latest"))

; No signals to anything outside the sandbox; a test ends what it started
; ("others" alone counts its own children).
(deny signal (target others))
(allow signal (target same-sandbox))

; No keychain: a test must never read, switch or renew a real sign-in;
; rush's tests keep sign-ins in fake vaults.
(deny mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc"))
(deny file-write* (subpath (string-append (param "HOME") "/Library/Keychains")))

; No talking to Claude Code's own daemon for the real ~/.claude, which
; hosts its background sessions outside rush's folder (a bench rush once
; stopped a real session through it). sbtest.sh passes its folder; a
; test's own daemon is under another (its account's folder's hash).
(deny network-outbound (remote unix-socket (subpath (param "CLAUDE_DAEMON"))))
