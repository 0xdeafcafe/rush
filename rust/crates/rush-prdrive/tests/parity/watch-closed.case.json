{
 "cmd": "watch",
 "args": [
  "pr",
  "--until=first",
  "o/w5#5"
 ],
 "session": "",
 "on": [
  "drive",
  "watch"
 ],
 "gh": [
  {
   "match": [
    "repos/o/w5/pulls/5"
   ],
   "stdout": "HTTP/2.0 200 OK\r\nEtag: \"e1\"\r\nX-Ratelimit-Remaining: 4999\r\n\r\n{\"number\": 5, \"title\": \"Fix the cap\", \"html_url\": \"https://github.com/o/w5/pull/5\", \"state\": \"closed\", \"merged\": false, \"head\": {\"sha\": \"abcdef1234567890\"}}"
  },
  {
   "match": [
    "repos/o/w5/commits/abcdef1234567890/check-runs"
   ],
   "stdout": "HTTP/2.0 200 OK\r\nEtag: \"e1\"\r\nX-Ratelimit-Remaining: 4999\r\n\r\n{\"total_count\": 0, \"check_runs\": []}"
  },
  {
   "match": [
    "repos/o/w5/commits/abcdef1234567890/status"
   ],
   "stdout": "HTTP/2.0 200 OK\r\nEtag: \"e1\"\r\nX-Ratelimit-Remaining: 4999\r\n\r\n{\"state\": \"pending\", \"statuses\": []}"
  },
  {
   "match": [
    "reviewThreads"
   ],
   "stdout": "{\"data\": {\"repository\": {\"pullRequest\": {\"reviewThreads\": {\"pageInfo\": {\"hasNextPage\": false, \"endCursor\": null}, \"nodes\": []}}}}}"
  },
  {
   "match": [
    "statusCheckRollup"
   ],
   "stdout": "{\"data\": {\"repository\": {\"pullRequest\": {\"commits\": {\"nodes\": [{\"commit\": {\"statusCheckRollup\": null}}]}}}}}"
  },
  {
   "match": [
    "rules/branches/"
   ],
   "stdout": "[]"
  },
  {
   "match": [
    "/protection"
   ],
   "stderr": "gh: Branch not protected (HTTP 404)",
   "exit": 1
  },
  {
   "match": [
    "code-scanning"
   ],
   "stdout": "[]"
  },
  {
   "match": [
    "api user --jq .login"
   ],
   "stdout": "alex\n"
  },
  {
   "match": [
    "orgs/o/members/sam"
   ],
   "stdout": "HTTP/2.0 204 No Content\r\n\r\n"
  },
  {
   "match": [
    "orgs/o/members/"
   ],
   "stderr": "gh: Not Found (HTTP 404)",
   "exit": 1
  },
  {
   "match": [
    "collaborators/"
   ],
   "stdout": "read\n"
  }
 ]
}
