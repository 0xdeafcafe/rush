{
  "name": "p",
  "description": "A <thing> & more",
  "version": "1",
  "category": "agents",
  "command": ["bin", "--x"],
  "env": {"Z": "1", "A": "${DATA}/x"},
  "tools": true,
  "sessions": ["list", "start"],
  "workspaces": ["~/Source"],
  "network": ["api.example.com:443"],
  "exec": {"kanban": ["~/.local/bin/kanban", "--json"]},
  "memoryMB": 64,
  "agents": {"rev": {"description": "d", "prompt": "p", "tools": ["Read", "Grep"], "n": 1.50}},
  "prompt": "Be kind.\nAlways.",
  "sidebar": true,
  "ui": ["events", "notify"],
  "commands": [{"name": "c", "description": "does c", "key": "ctrl+] b"}],
  "settings": [{"key": "k", "title": "K", "type": "choice", "choices": ["a", "b"], "default": "b"}],
  "cli": [{"name": "send", "description": "send it"}],
  "requires": {"os": ["darwin"]},
  "builtFrom": ["../lib"],
  "provides": ["cleanup.report"]
}
