{
 "cmd": "watch",
 "args": [
  "pr",
  "o/w10#10"
 ],
 "session": "",
 "on": [
  "drive",
  "watch"
 ],
 "gh": [
  {
   "match": [
    "repos/o/w10/pulls/10"
   ],
   "stderr": "To get started with GitHub CLI, please run:  gh auth login",
   "exit": 4
  },
  {
   "match": [
    "reviewThreads"
   ],
   "stdout": "{\"data\": {\"repository\": {\"pullRequest\": {\"reviewThreads\": {\"pageInfo\": {\"hasNextPage\": false, \"endCursor\": null}, \"nodes\": []}}}}}"
  },
  {
   "match": [
    "statusCheckRollup"
   ],
   "stdout": "{\"data\": {\"repository\": {\"pullRequest\": {\"commits\": {\"nodes\": [{\"commit\": {\"statusCheckRollup\": null}}]}}}}}"
  },
  {
   "match": [
    "rules/branches/"
   ],
   "stdout": "[]"
  },
  {
   "match": [
    "/protection"
   ],
   "stderr": "gh: Branch not protected (HTTP 404)",
   "exit": 1
  },
  {
   "match": [
    "code-scanning"
   ],
   "stdout": "[]"
  },
  {
   "match": [
    "api user --jq .login"
   ],
   "stdout": "alex\n"
  },
  {
   "match": [
    "orgs/o/members/sam"
   ],
   "stdout": "HTTP/2.0 204 No Content\r\n\r\n"
  },
  {
   "match": [
    "orgs/o/members/"
   ],
   "stderr": "gh: Not Found (HTTP 404)",
   "exit": 1
  },
  {
   "match": [
    "collaborators/"
   ],
   "stdout": "read\n"
  }
 ]
}
