---
// Bottle, printed label and live terminal evidence, with no client React.
import { Image } from "astro:assets";
import bottleStill from "../assets/bottle-still.png";
import Base from "../layouts/Base.astro";
import Zine from "../components/Zine";
---

<Base
  title="rush: every coding agent you run, in one terminal"
  description="rush puts Claude Code, Codex, Copilot, Kimi, Ollama and the rest in one list, in one terminal, on your Mac. Written in Rust."
>
  <a class="skip" href="#label-page">Skip to the label</a>
  <section class="bottle-intro" id="bottle-intro" aria-label="The rush bottle">
    <div class="bottle-stage">
      <Image class="bottle-still" src={bottleStill} format="png" alt="A glossy yellow rush bottle wrapped in the same red label as this page." loading="eager" fetchpriority="high" />
      <canvas class="bottle-canvas" aria-hidden="true"></canvas>
      <div class="bottle-nav"><strong>rush</strong><a href="#label-page">Skip to label</a></div>
      <div class="bottle-caption"><p>Every coding agent.<br />Under one cap.</p><code class="hero-install">brew install 0xdeafcafe/tap/rush</code><span class="hero-note">Plain <code>brew install rush</code> gets GNU’s restricted shell.</span></div>
      <div class="bottle-controls"><span class="bottle-cue">Scroll to unwrap ↓</span><button type="button" hidden>Use still image</button></div>
    </div>
  </section>
  <div id="label-page" tabindex="-1"><Zine /></div>
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/bottle";
</script>
